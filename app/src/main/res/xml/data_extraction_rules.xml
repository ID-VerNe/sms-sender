<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 加密秘密不备份；旧配置在迁移完成前仍可能含明文凭证，因此整文件排除。 -->
        <exclude domain="sharedpref" path="sms_sender_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sms_sender_prefs.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <!-- 去重表只保留哈希元数据，仍不参与云备份或设备迁移。 -->
        <exclude domain="database" path="sms_sender_db" />
    </cloud-backup>
    <device-transfer>
        <!-- 加密秘密不迁移；旧配置在迁移完成前仍可能含明文凭证，因此整文件排除。 -->
        <exclude domain="sharedpref" path="sms_sender_secure_prefs.xml" />
        <exclude domain="sharedpref" path="sms_sender_prefs.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <!-- 去重表只保留哈希元数据，仍不参与云备份或设备迁移。 -->
        <exclude domain="database" path="sms_sender_db" />
    </device-transfer>
</data-extraction-rules>